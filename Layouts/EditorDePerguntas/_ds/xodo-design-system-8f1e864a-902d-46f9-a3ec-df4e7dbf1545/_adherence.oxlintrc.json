{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/navigation/**",
              "ui_kits/report/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Montserrat|Inter))/i]",
        "message": "Font not provided by the design system. Available: Anton, Montserrat, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|highlight|key|ref|className|style|children)$/]",
        "message": "<BarDatum> doesn't accept that prop. Declared props: label, value, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: label, children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent)$/]",
        "message": "<Callout> tone must be one of 'default' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: icon, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerAccent'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|style|key|ref|className|style|children)$/]",
        "message": "<CornerAccent> doesn't accept that prop. Declared props: variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerAccent'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fino|medio|diagonal|arredondado|barra)$/]",
        "message": "<CornerAccent> variant must be one of 'fino' | 'medio' | 'diagonal' | 'arredondado' | 'barra'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|totalRow|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, totalRow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:continua|secao|pontilhada|vertical|curta)$/]",
        "message": "<Divider> variant must be one of 'continua' | 'secao' | 'pontilhada' | 'vertical' | 'curta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DotGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|cols|style|key|ref|className|style|children)$/]",
        "message": "<DotGrid> doesn't accept that prop. Declared props: rows, cols, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|methodology|sources|confidentiality|page|total|date|company|style|key|ref|className|style|children)$/]",
        "message": "<PageFooter> doesn't accept that prop. Declared props: title, methodology, sources, confidentiality, page, total, date, company, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|question|intro|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: index, label, question, intro, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, attribution, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:sections|current|onSelect|variant|icons|style|key|ref|className|style|children)$/]",
        "message": "<SectionNav> doesn't accept that prop. Declared props: sections, current, onSelect, variant, icons, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionNav'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:padrao|icones|progresso)$/]",
        "message": "<SectionNav> variant must be one of 'padrao' | 'icones' | 'progresso'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTopic'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionTopic> doesn't accept that prop. Declared props: label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|unit|delta|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, unit, delta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:diagnostico|evidencia|processo|informacao)$/]",
        "message": "<Tag> tone must be one of 'diagnostico' | 'evidencia' | 'processo' | 'informacao'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
