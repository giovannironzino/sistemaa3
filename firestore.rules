rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura/gravação apenas para o proprietário autenticado do documento ou consultor vinculado
    match /clients/{clientId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == clientId ||
        resource.data.linkedConsultorId == request.auth.uid
      );
    }
  }
}
